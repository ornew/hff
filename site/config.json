{
  "title": "HFF",
  "description": "HFF is a human-friendly, type-safe filter language with one syntax across processing systems.",
  "include": [
    "README.md",
    "docs/**/*.md",
    "spec/**/*.md"
  ],
  "exclude": [
    "**/TEMPLATE.md",
    "docs/optimizations/000-template.md"
  ],
  "prettyURLs": false,
  "bundledAssets": false,
  "staticDir": "site/public",
  "assets": [
    "LICENSE"
  ],
  "template": "site/layout.html",
  "templates": [
    "site/landing.html",
    "site/playground.html"
  ],
  "markdown": {
    "headingIDs": "goldmark",
    "alignAttributes": false
  },
  "tocDepth": 3,
  "pager": "group",
  "searchHeadings": true,
  "searchIndex": {
    "path": "search-index.js",
    "variable": "window.HFF_SEARCH_INDEX",
    "text": "html",
    "headingTitle": "heading",
    "headingText": "page"
  },
  "order": [
    "README.md",
    "spec/README.md",
    "spec/syntax.md",
    "spec/types.md",
    "spec/evaluation.md",
    "spec/methods.md",
    "spec/capabilities.md",
    "docs/tutorials/README.md",
    "docs/tutorials/01-first-filter.md",
    "docs/tutorials/02-service-integration.md",
    "docs/tutorials/03-extension-methods.md",
    "docs/tutorials/04-postgresql-translator.md",
    "docs/tutorials/05-go-bindings.md",
    "docs/tutorials/06-postgresql-bindings.md",
    "docs/guides/README.md",
    "docs/guides/getting-started.md",
    "docs/guides/go-api.md",
    "docs/guides/compiling.md",
    "docs/guides/schemas-and-values.md",
    "docs/guides/scalar-methods.md",
    "docs/guides/collections.md",
    "docs/guides/callbacks.md",
    "docs/guides/json.md",
    "docs/guides/temporal.md",
    "docs/guides/serialized-configuration.md",
    "docs/cookbook/README.md",
    "docs/reference/README.md",
    "docs/reference/methods.md",
    "docs/reference/program-ir.md",
    "docs/reference/go/README.md",
    "docs/reference/go/hff/README.md",
    "docs/reference/go/engine/README.md",
    "docs/reference/go/schema/README.md",
    "docs/reference/go/capabilities/README.md",
    "docs/reference/go/config/README.md",
    "docs/reference/go/backends/local/README.md",
    "docs/reference/go/backends/sql/README.md",
    "docs/reference/go/adapters/govalue/README.md",
    "docs/backends/README.md",
    "docs/backends/local/README.md",
    "docs/backends/local/configuration.md",
    "docs/backends/local/extensions.md",
    "docs/backends/postgresql/README.md",
    "docs/backends/postgresql/json.md",
    "docs/backends/postgresql/composites.md",
    "docs/backends/postgresql/flattened-structures.md",
    "docs/backends/postgresql/relations.md",
    "docs/backends/postgresql/optimizations.md",
    "docs/optimizations/001-postgresql-order-independence.md",
    "docs/design/README.md",
    "docs/development/README.md",
    "docs/development/parser.md",
    "docs/development/parsing.md",
    "docs/development/site.md",
    "docs/development/checks.md",
    "docs/development/finite-limits.md"
  ],
  "sections": [
    {
      "title": "Overview",
      "match": [
        "README.md",
        "docs/playground.md"
      ],
      "collapsed": false
    },
    {
      "title": "Tutorials",
      "match": [
        "docs/tutorials/**"
      ],
      "collapsed": false
    },
    {
      "title": "Guides",
      "match": [
        "docs/guides/**"
      ],
      "collapsed": false
    },
    {
      "title": "Cookbook",
      "match": [
        "docs/cookbook/**"
      ],
      "collapsed": false
    },
    {
      "title": "Backends",
      "match": [
        "docs/backends/**"
      ],
      "collapsed": false,
      "children": [
        {
          "title": "Local",
          "match": [
            "docs/backends/local/**"
          ],
          "collapsed": true
        },
        {
          "title": "PostgreSQL",
          "match": [
            "docs/backends/postgresql/**"
          ],
          "collapsed": true
        }
      ]
    },
    {
      "title": "Reference",
      "match": [
        "docs/reference/**"
      ],
      "collapsed": false,
      "children": [
        {
          "title": "Go Reference",
          "match": [
            "docs/reference/go/**"
          ],
          "collapsed": true
        }
      ]
    },
    {
      "title": "Specification",
      "match": [
        "spec/**"
      ],
      "collapsed": false
    },
    {
      "title": "Design Records",
      "match": [
        "docs/design/**"
      ],
      "collapsed": true
    },
    {
      "title": "Development",
      "match": [
        "docs/development/**",
        "docs/*.md",
        "docs/optimizations/**"
      ],
      "collapsed": true
    }
  ],
  "recordIndexes": [
    {
      "source": "docs/design/README.md",
      "directory": "docs/design",
      "title": "Introduction",
      "optional": true,
      "introduction": "These documents explain the rationale, contracts, and tradeoffs behind HFF's language design. The language specification defines the query language; records provide context for individual design choices.",
      "columns": [
        {
          "title": "Record",
          "field": "Title"
        },
        {
          "title": "Status",
          "field": "Status"
        },
        {
          "title": "Date",
          "field": "Date"
        },
        {
          "title": "Author",
          "field": "Author"
        }
      ],
      "required": [
        "Status",
        "Date",
        "Author"
      ],
      "template": "000-template.md",
      "templateText": "Use the [record template](000-template.md) when adding a design record.",
      "notice": "Generated by hack/generate-design-index.sh. Do not edit."
    }
  ],
  "redirects": {
    "/docs/guides/local-evaluation.html": "/docs/backends/local/",
    "/docs/guides/configuration.html": "/docs/backends/local/configuration.html",
    "/docs/guides/extensions.html": "/docs/backends/local/extensions.html",
    "/docs/guides/sql.html": "/docs/backends/postgresql/",
    "/docs/guides/program-ir.html": "/docs/reference/program-ir.html",
    "/docs/reference/go-api.html": "/docs/guides/go-api.html"
  },
  "redirectRules": false,
  "redirectTemplate": "site/redirect.html"
}
