// HFF's fixed grammar. Whitespace is a predicate boundary, not a global skip.
package syntax

type Expr = Empty | Or | And | Not | Binary | Unary | Access | Group | Number | String | Bool | Null | Variable | ListLiteral | ObjectLiteral
type Name = PlainName | QuotedName
type Argument = Expr | Callback
type Suffix = FieldAccess | IndexAccess | MethodCall | Guard | TypeGuard
type TypeExpr = TypeUnion | TypeNamed | TypeGroup

type Empty struct {}
type Or struct { Terms []Expr }
type And struct { Terms []Expr }
type Not struct { X Expr }
type Binary struct { Left Expr, Op Match, Right Expr }
type Unary struct { Op Match, X Expr }
type Access struct { Base Expr, Parts []Suffix }
type Group struct { X Expr }
type Variable struct { Name Name }
type Number terminal
type String terminal
type Bool terminal
type Null terminal
type PlainName terminal
type QuotedName terminal
type ListLiteral struct { Values []Expr }
type ObjectLiteral struct { Members []Member }
type Member struct { Key String, Value Expr }
type FieldAccess struct { Name Name }
type IndexAccess struct { Index Expr }
type MethodCall struct { Name Name, Args []Argument }
type Guard struct {}
type Callback struct { Params []Name, Body Expr }
type TypeGuard struct { Type TypeExpr }
type TypeUnion struct { Types []TypeExpr }
type TypeNamed struct { Name TypeName, Args []TypeExpr }
type TypeGroup struct { X TypeExpr }
type TypeName terminal

def main: Expr = present / empty
def present: Expr = ws x:expression ws $$ -> $x
def empty: Empty = ws $$ -> new Empty{}
def expression: Expr = first:conjunction rest:(-ws -"|" -ws x:conjunction)*
    -> new Or{Terms: concat(list($first), map($rest, (r) => $r.x))}
def conjunction: Expr = first:predicate rest:(-space x:predicate)*
    -> new And{Terms: concat(list($first), map($rest, (r) => $r.x))}
// Require the whole compact predicate before accepting it. Recovery preserves
// outer separators, quoted text, and balanced delimiters to find the next leaf.
def predicate: Expr = x:completepredicate
    #recover(skip=recoverpredicate) -> $x
def completepredicate: Expr = x:(negation / comparison) predicateend -> $x
def predicateend = (&(space / "|" / "," / ")" / "]" / "}" / $$))
    #error(message="expected a predicate separator; operators and accesses must touch their operands, and comparisons cannot be chained")
def negation: Not = "!" x:predicate -> new Not{X: $x}
// Comparison is deliberately non-associative.
def comparison: Expr = compare / arithmetic
def compare: Binary = lhs:arithmetic op:compareop rhs:comparisonvalue
    -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
def comparisonvalue: Expr = arithmetic / missingcomparisonvalue
// This always-failing fallback labels a missing operand at its start, without
// replacing a more specific error deeper inside a quoted or grouped value.
def missingcomparisonvalue: Empty = (!. .)
    #error(message="expected a value after the comparison operator (without intervening whitespace)") -> new Empty{}
def compareop = "!~" / "!=" / "<=" / ">=" / equalop / "~" / "<" / ">"
def equalop = op:"=" !">" -> $op
def arithmetic: Expr = pratt {
    operand access
    level { infix left "+" / "-" -> new Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "*" / "/" / "%" -> new Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { prefix "-" -> new Unary{Op: $op, X: $rhs} }
}
def access: Expr = base:primary parts:suffix* -> new Access{Base: $base, Parts: $parts}
def suffix: Suffix = fieldaccess / indexaccess / typeguard / methodcall / guard
def fieldaccess: FieldAccess = "." n:fieldname -> new FieldAccess{Name: $n}
def fieldname: Name = name / missingfieldname
def missingfieldname: PlainName = (!. .)
    #error(message="expected a field name after '.'; quote unusual or reserved names with backticks")
def indexaccess: IndexAccess = "[" ws x:expression ws closebracket -> new IndexAccess{Index: $x}
def methodcall: MethodCall = ":" n:methodname args:callargs? -> new MethodCall{Name: $n, Args: concat($args)}
def methodname: Name = name / missingmethodname
def missingmethodname: PlainName = (!. .) #error(message="expected a method name after ':'")
def callargs = "(" ws args:arguments? ws closeparen -> concat($args)
def guard: Guard = "!" !("=" / "~") -> new Guard{}
def typeguard: TypeGuard = ":" "[" ws t:typeref ws closebracket -> new TypeGuard{Type: $t}
def typeref: TypeExpr = first:typeatom rest:(-ws -"|" -ws t:typeatom)*
    -> new TypeUnion{Types: concat(list($first), map($rest, (r) => $r.t))}
def typeatom: TypeExpr = typegroup / typenamed
def typegroup: TypeGroup = "(" ws t:typeref ws ")" -> new TypeGroup{X: $t}
def typenamed: TypeNamed = n:typename args:typeparameters? -> new TypeNamed{Name: $n, Args: concat($args)}
def typename: TypeName = (?a-zA-Z_) identpart*
def typeparameters = "[" ws ts:typelist ws "]" -> $ts
def typelist = first:typeref rest:(-ws -"," -ws t:typeref)*
    -> concat(list($first), map($rest, (r) => $r.t))
def primary: Expr = group / object / array / string / number / bool / null / variable / missingprimary
def missingprimary: Empty = (!. .)
    #error(message="expected a value, field name, or parenthesized expression") -> new Empty{}
def group: Group = "(" ws x:expression ws closeparen -> new Group{X: $x}
def variable: Variable = n:name -> new Variable{Name: $n}
def arguments = first:argument rest:(-ws -"," -ws x:argument)*
    -> concat(list($first), map($rest, (r) => $r.x))
def argument: Argument = callbackarg / expression
def callbackarg: Callback = callback / groupedcallback
def groupedcallback: Callback = "(" ws x:callbackarg ws ")" -> $x
def callback: Callback = params:parameters ws "=>" ws body:expression
    -> new Callback{Params: $params, Body: $body}
def parameters = oneparam / manyparams
def oneparam = n:name -> list($n)
def manyparams = "(" ws ns:names? ws ")" -> concat($ns)
def names = first:name rest:(-ws -"," -ws n:name)*
    -> concat(list($first), map($rest, (r) => $r.n))
def array: ListLiteral = "[" ws es:elements? ws closebracket -> new ListLiteral{Values: concat($es)}
def elements = first:expression rest:(-ws -"," -ws x:expression)*
    -> concat(list($first), map($rest, (r) => $r.x))
def object: ObjectLiteral = "{" ws ms:members? ws closebrace -> new ObjectLiteral{Members: concat($ms)}
def members = first:member rest:(-ws -"," -ws m:member)*
    -> concat(list($first), map($rest, (r) => $r.m))
def member: Member = k:string ws ":" ws x:expression -> new Member{Key: $k, Value: $x}
def string: String = "\"" ((?^"\\\u{0}-\u{1f})+ / escape)* stringend
def stringend = "\"" #error(message="expected a closing double quote or a valid JSON escape")
def escape = "\\" ((?"\\/bfnrt) / "u" hex hex hex hex)
def hex = (?0-9a-fA-F)
def number: Number = integer fraction? exponent?
def integer = "0" / (?1-9) (?0-9)*
def fraction = "." (?0-9)+
def exponent = (?eE) (?+\-)? (?0-9)+
def bool: Bool = ("true" / "false") !identpart
def null: Null = "null" !identpart
def name: Name = quotedname / plainname
def plainname: PlainName = !(("true" / "false" / "null") !identpart) (?a-zA-Z_) identpart*
def identpart = (?a-zA-Z_0-9)
def quotedname: QuotedName = "`" ((?^`\\)+ / "\\" (?`\\))* quotednameend
def quotednameend = "`" #error(message="expected a closing backtick or a backslash escape for a backtick or backslash")
def closeparen = ")" #error(message="expected ')' to close the group or method arguments")
def closebracket = "]" #error(message="expected ']' to close the list, index, or type guard")
def closebrace = "}" #error(message="expected '}' to close the object")
// Skip complete quoted regions and balanced containers, rather than treating
// their internal spaces/commas as independent predicates after an error.
def recoverpredicate = (recoverstring / recovername / recoverparen / recoverlist / recoverobject / (?^ \t\r\n|,\u{28}\u{29}\u{5b}\u{5d}{}"`))+
def recoverstring = "\"" ("\\" . / (?^"\\))* "\""?
def recovername = "`" ("\\" . / (?^`\\))* "`"?
def recoverparen = "(" (recoverstring / recovername / recoverparen / recoverlist / recoverobject / (?^\u{28}\u{29}\u{5b}\u{5d}{}"`))* ")"?
def recoverlist = "[" (recoverstring / recovername / recoverparen / recoverlist / recoverobject / (?^\u{28}\u{29}\u{5b}\u{5d}{}"`))* "]"?
def recoverobject = "{" (recoverstring / recovername / recoverparen / recoverlist / recoverobject / (?^\u{28}\u{29}\u{5b}\u{5d}{}"`))* "}"?
def space = (? \t\r\n)+
def ws = (? \t\r\n)*
